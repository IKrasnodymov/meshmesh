<?xml version="1.0" encoding="utf-8"?>
<!-- Saved Wi-Fi passwords stay on this phone: no cloud backup, no device transfer. -->
<data-extraction-rules>
    <cloud-backup><exclude domain="root" /><exclude domain="sharedpref" /><exclude domain="file" /><exclude domain="database" /></cloud-backup>
    <device-transfer><exclude domain="root" /><exclude domain="sharedpref" /><exclude domain="file" /><exclude domain="database" /></device-transfer>
</data-extraction-rules>
